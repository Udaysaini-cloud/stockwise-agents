# Coordinator Agent Configuration
COORDINATOR_NAME="stockwise-coordinator"
COORDINATOR_SEED="stockwise_coordinator_local_dev_seed_phrase_2026"
COORDINATOR_PORT=8001

# Agentverse Mailbox Configuration (Required for ASI:One & Agentverse discovery)
# Generate this on https://agentverse.ai by creating an agent or connecting mailbox
