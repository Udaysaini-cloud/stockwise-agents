# ==========================================
# StockWise Agents - Environment Variables Example
# ==========================================

# Coordinator Agent Configuration
COORDINATOR_NAME="stockwise-coordinator"
COORDINATOR_SEED="your_coordinator_seed_phrase_here"
COORDINATOR_PORT=8001

# Agentverse Mailbox Configuration (Required for ASI:One & Agentverse discovery)
# Generate this on https://agentverse.ai by creating an agent or connecting mailbox
AGENT_MAILBOX_KEY="your_agentverse_mailbox_key_here"

# ASI:One API Configuration (https://asi1.ai/dashboard/api-keys)
# Optional for local deterministic procurement engine; used for conversational fallback
ASI1_API_KEY="your_asi1_api_key_here"

# Test Client Configuration (for local peer-to-peer verification)
CLIENT_NAME="stockwise-test-client"
CLIENT_SEED="your_client_seed_phrase_here"
CLIENT_PORT=8002
COORDINATOR_ADDRESS=""

