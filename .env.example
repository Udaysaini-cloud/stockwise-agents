# ASI:One API Configuration (https://asi1.ai/dashboard/api-keys)
# Optional for initial local Hello test; required for ASI:One LLM reasoning & chat
ASI1_API_KEY=

# Test Client Configuration (for local verification)
CLIENT_NAME="stockwise-test-client"
CLIENT_SEED="stockwise_client_test_seed_phrase_2026"
CLIENT_PORT=8002
COORDINATOR_ADDRESS=
